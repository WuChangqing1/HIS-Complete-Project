# Native Windows 11 deployment. First start creates .env and random secrets.
# Existing .env and MySQL data files are never overwritten by deployment.
DB_PASSWORD=REPLACE_ON_FIRST_DEPLOY
MYSQL_ROOT_PASSWORD=REPLACE_ON_FIRST_DEPLOY
BOOTSTRAP_PASSWORD=REPLACE_ON_FIRST_DEPLOY
DEMO_PASSWORD=REPLACE_ON_FIRST_DEPLOY
DATA_ENCRYPTION_KEY=REPLACE_ON_FIRST_DEPLOY
DEMO_MODE=true
WEB_BIND=127.0.0.1
WEB_PORT=8088
DB_PORT=33306
GUEST_ACCESS=false
